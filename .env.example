# ---- core -------------------------------------------------------------------
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# ---- database ---------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_POOL_MAX=10
# Set to false only in unit-test processes that never query the database.
DATABASE_ENABLED=true

# ---- web origins ------------------------------------------------------------
# Comma-separated. Only these origins may make unsafe cross-site requests.
WEB_ORIGIN=https://your-app.vercel.app
API_PUBLIC_URL=https://your-api.up.railway.app

# ---- authentication (access code -> JWT) ------------------------------------
# HS256 signing key. Generate with: openssl rand -base64 48
# Rotating this invalidates every issued token.
JWT_SECRET=replace-with-at-least-32-random-chars
# How long an issued token stays valid; the user re-enters a code after this.
JWT_TTL_HOURS=24
# Access codes are permanent logins: one per user, never expiring, reusable.
# Leave this false. It exists only as an escape hatch for one-off invitation
# codes, which stop working after a single login.
ACCESS_CODE_SINGLE_USE=false

# ---- storage ----------------------------------------------------------------
# s3 -> Railway Buckets, filesystem -> local dev/test adapter served by the API
STORAGE_DRIVER=s3
STORAGE_FILESYSTEM_ROOT=./.storage

# Map these from the Railway Bucket connection details in the dashboard.
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_REGION=auto
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_BUCKET_ORIGINALS=media-originals
RAILWAY_BUCKET_GENERATED=media-generated

PRESIGNED_UPLOAD_TTL_SECONDS=600
PRESIGNED_DOWNLOAD_TTL_SECONDS=300

# ---- upload limits ----------------------------------------------------------
MAX_IMAGE_SIZE_MB=25
MAX_IMAGE_PIXELS=40000000
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ---- worker -----------------------------------------------------------------
WORKER_ENABLED=true
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=750
WORKER_IDLE_MAX_BACKOFF_MS=5000
WORKER_JOB_LEASE_SECONDS=300
WORKER_JOB_TIMEOUT_SECONDS=120
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=5
WORKER_RETRY_JITTER_RATIO=0.25
WORKER_STALE_SWEEP_INTERVAL_MS=60000

# ---- rate limits (requests per window) --------------------------------------
RATE_LIMIT_DEMO_AUTH=10
RATE_LIMIT_DEMO_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_DEMO_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_UPLOAD_COMPLETE_PER_MINUTE=10
RATE_LIMIT_GENERATION_PER_MINUTE=3
RATE_LIMIT_STATUS_PER_MINUTE=120
RATE_LIMIT_DOWNLOAD_URL_PER_MINUTE=30
RATE_LIMIT_GENERAL_PER_MINUTE=300

# ---- quotas -----------------------------------------------------------------
MAX_CONCURRENT_GENERATIONS_PER_USER=2
MAX_GENERATIONS_PER_USER_PER_DAY=20
MAX_PENDING_UPLOADS_PER_USER=5

# ---- image output -----------------------------------------------------------
IMAGE_JPEG_QUALITY=85
IMAGE_PRESERVE_TRANSPARENCY=true
IMAGE_TRANSPARENT_BACKGROUND=#ffffff

# ---- observability (all optional) -------------------------------------------
# OpenTelemetry traces over OTLP/HTTP; leave empty to disable export.
# This is a collector base URL, e.g. http://otel-collector:4318 (the exporter
# appends /v1/traces). Logs and /metrics work without it.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=blueberrylabs-backend
METRICS_ENABLED=true

# ---- deployment -------------------------------------------------------------
# Apply migrations on boot. Set false when a separate release step does it.
RUN_MIGRATIONS=true
